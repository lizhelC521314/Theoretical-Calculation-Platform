{
  "name": "ctr-calc",
  "productName": "汽车零部件数字设计平台",
  "version": "0.1.0",
  "private": true,
  "description": "面向汽车零部件设计与 CAE 工程师的理论公式计算平台",
  "author": "CTR Engineering",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build:web": "tsc --noEmit && vite build",
    "build:web:standard": "tsc --noEmit && vite build --mode standard",
    "build": "npm run build:web && electron-builder --config electron-builder.config.cjs",
    "build:standard": "npm run build:web:standard && electron-builder --config electron-builder.standard.config.cjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "bcryptjs": "^2.4.3",
    "docx": "^9.14.0",
    "echarts": "^5.5.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "katex": "^0.16.11",
    "mammoth": "^1.13.0",
    "parquetjs-lite": "^0.8.7",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.2.0",
    "electron-builder": "^25.0.5",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.1"
  }
}
